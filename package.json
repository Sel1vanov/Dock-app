{
  "name": "dock",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write src server/src server/tests",
    "server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "dev": "node scripts/dev.mjs",
    "db:dump": "docker compose exec -T postgres pg_dump -U postgres --no-owner --clean --if-exists dock > dock_dump.sql",
    "db:restore": "docker compose exec -T postgres psql -q -o /dev/null -U postgres -d dock < dock_dump.sql",
    "postinstall": "npm --prefix server install --no-audit --no-fund && npm --prefix server run env:init"
  },
  "private": true
}
