{
  "name": "dock-api",
  "version": "1.0.0",
  "description": "Dock REST API: Fastify + MikroORM + PostgreSQL",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "env:init": "node scripts/init-env.mjs",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:migrate:down": "tsx src/database/migrate.ts down",
    "db:status": "tsx src/database/migrate.ts status",
    "db:seed": "tsx src/database/seed.ts",
    "db:schema-diff": "tsx scripts/schema-sql.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"tests/*.test.ts\"",
    "prepare:db": "tsx src/database/migrate.ts up && tsx src/database/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3"
  }
}
