# Образец настроек сервера. Скопируйте в .env (или выполните `npm run env:init` —
# он создаст .env со случайными секретами). Файл .env не попадает в git.

NODE_ENV=development
HOST=0.0.0.0
PORT=8000

# PostgreSQL. Локально: `docker compose up -d` в корне репозитория.
# Supabase: Dashboard → Connect → Session pooler, затем DATABASE_SSL=true:
#   postgresql://postgres.<project-ref>:<пароль-БД>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dock
DATABASE_SSL=false
# Отдельная база для автотестов (схема в ней пересоздаётся при каждом запуске!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dock_test

# Секреты: случайные строки не короче 32 символов. Значения ниже — фиктивные.
JWT_SECRET=replace-with-random-string-at-least-32-chars
JWT_EXPIRES_IN=3600
FILE_URL_SECRET=replace-with-another-random-string-32-chars
FILE_URL_TTL=3600

FILES_DIR=./storage
CORS_ORIGIN=*
LOG_LEVEL=info
# true — печатать SQL-запросы ORM в консоль (видно, что списки грузятся без N+1)
DB_DEBUG=false
