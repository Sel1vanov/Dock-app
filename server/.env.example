# пример настроек сервера. скопировать в .env (или запустить npm run env:init -
# он сам создаст .env со случайными секретами). сам .env в git не попадает

NODE_ENV=development
HOST=0.0.0.0
PORT=8000

# postgres в докере: docker compose up -d в корне репы (docker-compose.yml), строку менять не надо
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dock

# секреты: случайные строки от 32 символов. значения ниже - заглушки
JWT_SECRET=replace-with-random-string-at-least-32-chars
JWT_EXPIRES_IN=3600
# сколько секунд сессию можно тихо продлевать без ввода пароля (30 дней)
SESSION_MAX_AGE=2592000
FILE_URL_SECRET=replace-with-another-random-string-32-chars
FILE_URL_TTL=3600

FILES_DIR=./storage
CORS_ORIGIN=*
LOG_LEVEL=info
# true - печатать sql от orm в консоль (видно, что списки грузятся без N+1)
DB_DEBUG=false
