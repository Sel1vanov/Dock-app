# настройки приложения. можно скопировать в .env (cp .env.example .env), но не обязательно
#
# адрес сервера api. если пусто - приложение само идет на порт 8000 того же компа,
# где запущен expo (телефон с expo go должен быть в той же wi-fi)
# задать явно, если сервер на другом адресе, например:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=
